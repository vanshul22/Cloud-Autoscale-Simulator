# Copy to .env.local for local use, or set these in Vercel -> Project -> Settings -> Environment Variables.
#
# Leave BOTH unset for local development: the app keeps the world in memory.
# They are REQUIRED in production: serverless functions do not share memory, so
# without Redis every visitor would see a different, constantly resetting world.
#
# Get them from https://console.upstash.com/redis -> your database -> "REST API"
# (use the REST URL and REST TOKEN, not the redis:// connection string).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel's Upstash integration injects these names instead. The app accepts either pair.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
